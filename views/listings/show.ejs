<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wanderlust – <%= listing.title %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <h1><a href="/listings">🌍 Wanderlust</a></h1>
    </header>

    <main>
      <a href="/listings" class="back-link">← Back to Listings</a>

      <div class="listing-detail">
        <img
          src="<%= listing.image.url %>"
          alt="<%= listing.title %>"
          class="detail-img"
          onerror="this.src='https://images.unsplash.com/photo-1625505826533-5c80aca7d157?auto=format&fit=crop&w=800&q=60'"
        />

        <div class="detail-body">
          <h2><%= listing.title %></h2>
          <p class="description"><%= listing.description %></p>

          <ul class="detail-meta">
            <li>📍 <strong>Location:</strong> <%= listing.location %>, <%= listing.country %></li>
            <li>💰 <strong>Price:</strong> ₹<%= listing.price.toLocaleString("en-IN") %> / night</li>
          </ul>

          <div class="actions">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-secondary">✏️ Edit Listing</a>

            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="inline-form">
              <button class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this listing?')">
                🗑️ Delete Listing
              </button>
            </form>
          </div>
        </div>
      </div>
    </main>

    <footer>
      <p>&copy; Mandeep Sharma | 2025 Wanderlust. All rights reserved.</p>
    </footer>
  </body>
</html>
