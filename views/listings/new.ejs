<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wanderlust – New Listing</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <h1><a href="/listings">🌍 Wanderlust</a></h1>
    </header>

    <main>
      <a href="/listings" class="back-link">← Back to Listings</a>

      <div class="form-container">
        <h2>Create a New Listing</h2>

        <form method="POST" action="/listings">
          <div class="form-group">
            <label for="title">Title</label>
            <input
              id="title"
              name="listing[title]"
              placeholder="e.g. Cozy Beachfront Cottage"
              type="text"
              required
            />
          </div>

          <div class="form-group">
            <label for="description">Description</label>
            <textarea
              id="description"
              name="listing[description]"
              placeholder="Describe your listing..."
              rows="4"
            ></textarea>
          </div>

          <div class="form-group">
            <label for="image">Image URL</label>
            <input
              id="image"
              name="listing[image][url]"
              placeholder="https://images.unsplash.com/..."
              type="url"
            />
          </div>

          <div class="form-group">
            <label for="price">Price per Night (₹)</label>
            <input
              id="price"
              name="listing[price]"
              placeholder="e.g. 1500"
              type="number"
              min="0"
            />
          </div>

          <div class="form-group">
            <label for="location">Location</label>
            <input
              id="location"
              name="listing[location]"
              placeholder="e.g. Goa"
              type="text"
            />
          </div>

          <div class="form-group">
            <label for="country">Country</label>
            <input
              id="country"
              name="listing[country]"
              placeholder="e.g. India"
              type="text"
            />
          </div>

          <button type="submit" class="btn btn-primary">Add Listing</button>
        </form>
      </div>
    </main>

    <footer>
      <p>&copy; Mandeep Sharma | 2025 Wanderlust. All rights reserved.</p>
    </footer>
  </body>
</html>
