<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wanderlust – Edit Listing</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <h1><a href="/listings">🌍 Wanderlust</a></h1>
    </header>

    <main>
      <a href="/listings/<%= listing._id %>" class="back-link">← Back to Listing</a>

      <div class="form-container">
        <h2>Edit Listing</h2>

        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
          <div class="form-group">
            <label for="title">Title</label>
            <input
              id="title"
              name="listing[title]"
              value="<%= listing.title %>"
              type="text"
              required
            />
          </div>

          <div class="form-group">
            <label for="description">Description</label>
            <textarea
              id="description"
              name="listing[description]"
              rows="4"
            ><%= listing.description %></textarea>
          </div>

          <div class="form-group">
            <label for="image">Image URL</label>
            <input
              id="image"
              name="listing[image][url]"
              value="<%= listing.image.url %>"
              type="url"
            />
          </div>

          <div class="form-group">
            <label for="price">Price per Night (₹)</label>
            <input
              id="price"
              name="listing[price]"
              value="<%= listing.price %>"
              type="number"
              min="0"
            />
          </div>

          <div class="form-group">
            <label for="location">Location</label>
            <input
              id="location"
              name="listing[location]"
              value="<%= listing.location %>"
              type="text"
            />
          </div>

          <div class="form-group">
            <label for="country">Country</label>
            <input
              id="country"
              name="listing[country]"
              value="<%= listing.country %>"
              type="text"
            />
          </div>

          <button type="submit" class="btn btn-primary">Save Changes</button>
        </form>
      </div>
    </main>

    <footer>
      <p>&copy; Mandeep Sharma | 2025 Wanderlust. All rights reserved.</p>
    </footer>
  </body>
</html>
